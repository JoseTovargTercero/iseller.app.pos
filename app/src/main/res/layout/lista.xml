<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/solid_dark_op"
    tools:context=".lista">

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:elevation="8dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


            <TextView
                android:id="@+id/ultima_act"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="15dp"
                android:text="1*10/7 PENDIENTE POR VOTAR"
                android:textColor="@color/white"
                android:textSize="13dp" />
            <Button
                android:visibility="gone"
                android:id="@+id/lista"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:drawableTint="@color/white"
                android:background="@color/zxing_transparent"
                android:drawableLeft="@drawable/ic_baseline_keyboard_backspace_24" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/linearLayout2"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Aquí puedes agregar el contenido del ScrollView -->
        <ListView
            android:id="@+id/listView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/linearLayout2"
            app:layout_constraintBottom_toBottomOf="parent"
            android:divider="@android:color/darker_gray"
            android:dividerHeight="1dp" />
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
