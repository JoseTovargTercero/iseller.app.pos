<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/solid_dark_op"
    tools:context=".Reporte_flujo">


    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="11dp"
        android:layout_marginTop="25dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    <LinearLayout
        android:id="@+id/linearLayout3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">


            <TextView
                android:id="@+id/ultima_act"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="15dp"
                android:padding="5dp"
                android:text="Ultima actualizacion:"
                android:textColor="@color/white"
                android:textSize="13dp" />


            <TextView
                android:id="@+id/centro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="15dp"
                android:padding="5dp"
                android:text="Centro no disponible"
                android:textColor="@color/white"
                android:textSize="15dp"
                android:textStyle="bold" />


        </LinearLayout>

        <Button
            android:id="@+id/lista"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:drawableTint="@color/white"
            android:onClick="onClick"
            android:background="@color/zxing_transparent"
            android:drawableLeft="@drawable/baseline_format_list_bulleted_24" />



    </LinearLayout>



    </LinearLayout>



    <LinearLayout
        android:id="@+id/linearLayout4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:layout_marginTop="21dp"
        android:gravity="right"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/linearLayout2">
        <Button
            android:id="@+id/btn_update"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_gravity="center"
            android:background="@drawable/btn_style"
            android:drawableLeft="@drawable/baseline_refresh_24"
            android:drawablePadding="2dp"
            android:layout_marginRight="8dp"
            android:drawableTint="@color/white"
            android:onClick="onClick"
            android:paddingVertical="0dp"
            android:paddingLeft="9dp"
            android:textColor="@color/black"
            android:textSize="12dp"
            />


    <Button
        android:id="@+id/btn_report"
        android:layout_width="wrap_content"
        android:layout_height="35dp"
        android:background="@drawable/btn_white"
        android:drawableLeft="@drawable/baseline_perm_phone_msg_24"
        android:layout_gravity="center"
        android:gravity="center"
        android:onClick="onClick"
        android:paddingVertical="0dp"
        android:paddingHorizontal="9dp"
        android:text="Reportar"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="12dp"
        app:backgroundTint="@color/white"
         />

    </LinearLayout>



    <androidx.cardview.widget.CardView
        android:id="@+id/card_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardElevation="4dp"
        app:cardCornerRadius="8dp"
        app:cardBackgroundColor="@color/solid_dark"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/linearLayout4">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:id="@+id/amount2"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginBottom="10dp"
                android:layout_gravity="center"
                android:background="@drawable/baseline_bar_chart_24"
                />


            <TextView
                android:id="@+id/month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Meta del día"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold" />







        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Progreso"
                android:layout_marginBottom="3dp"
                android:textColor="@color/button_blue"
                android:layout_weight="1"
                android:textSize="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Faltante"
                android:gravity="right"
                android:layout_marginBottom="3dp"
                android:layout_weight="1"
                android:textColor="@color/white"
                android:textSize="12dp" />

        </LinearLayout>



            <ProgressBar
                android:id="@+id/progress_bar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:progress="0"
                android:progressDrawable="@drawable/custom_progressbar" />




            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingVertical="10dp"
                android:paddingHorizontal="5dp"
                android:orientation="horizontal">


                <TextView
                    android:id="@+id/asistencia_1x10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" 0"
                    android:layout_marginBottom="3dp"
                    android:textColor="@color/button_blue"
                    android:layout_weight="1"
                    android:drawableLeft="@drawable/baseline_people_24"
                    android:textStyle="bold"
                    android:textSize="28dp" />

                <TextView
                    android:id="@+id/resta_meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:layout_marginBottom="3dp"
                    android:textColor="@color/white"
                    android:drawableTint="@color/white"
                    android:gravity="right"
                    android:drawableLeft="@drawable/baseline_people_outline_24"
                    android:textStyle="bold"
                    android:textSize="28dp" />

            </LinearLayout>







        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/solid_dark"
        android:layout_margin="16dp"
        android:id="@+id/listaVertical"
        app:cardCornerRadius="8dp"

        app:layout_constraintTop_toBottomOf="@id/card_view"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/baseline_bar_chart_24"
                    />
                <ImageView
                    android:id="@+id/icon_net_banking"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/icon_1" />

                <TextView
                    android:id="@+id/text_net_banking"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/icon_net_banking"
                    android:text="Registros 1*10 / 1*10*7"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/unopordiez"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/text_net_banking"
                    android:layout_toEndOf="@id/icon_net_banking"
                    android:text="0"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/unopordiez_porcentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentTop="true"
                    android:text="*"
                    android:textSize="14sp"
                    android:textColor="@color/white" />
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp">

                <ImageView
                    android:id="@+id/icon_food_drinks"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/icon_3" />

                <TextView
                    android:id="@+id/text_food_drinks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/icon_food_drinks"
                    android:textColor="@color/white"
                    android:text="Electores del centro"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/electores_centro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/text_food_drinks"
                    android:layout_toEndOf="@id/icon_food_drinks"
                    android:text="0"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/text_date_food_drinks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentTop="true"
                    android:text="*"
                    android:textSize="12sp"
                    android:textColor="@color/white" />
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/icon_clothes"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/icon_2" />

                <TextView
                    android:id="@+id/text_clothes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:layout_toEndOf="@id/icon_clothes"
                    android:text="Asistencia total"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/reportes_realizados"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/text_clothes"
                    android:layout_toEndOf="@id/icon_clothes"
                    android:text="0"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/asistencia_centro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentTop="true"
                    android:text="*"
                    android:textSize="14sp"
                    android:textColor="@color/white" />
            </RelativeLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:orientation="horizontal"


        app:layout_constraintTop_toBottomOf="@+id/listaVertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:layout_weight="1"
            android:orientation="vertical"
            app:cardCornerRadius="8dp"
            android:background="@drawable/card_blue"
            android:padding="8dp"
            android:gravity="center">








            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="5dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tus_reortes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@android:color/white"
                    android:textSize="36sp"
                    android:textStyle="bold" />

            </LinearLayout>










            <TextView
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Tus reportes realizados"
                android:gravity="center"
                android:textSize="14sp"
                android:textColor="#fff"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/card_blue"
            android:padding="8dp"
            android:layout_marginStart="8dp"
            android:gravity="center">



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="5dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/resta_centro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@android:color/white"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <TextView
                    android:visibility="gone"
                    android:id="@+id/resta_centro_pocentaje"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableTint="@color/white"
                    android:gravity="bottom"
                    android:text="0%"
                    android:textColor="@color/button_blue"
                    android:textSize="10dp"
                    android:textStyle="bold" />

            </LinearLayout>



            <TextView
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Porcentaje de participación"
                android:textSize="14sp"
                android:gravity="center"
                android:textColor="#fff"
                android:layout_marginTop="4dp" />
        </LinearLayout>

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
